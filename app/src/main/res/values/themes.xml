<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Base app theme. Material 3 + dynamic color (Material You) is applied at runtime via
      DynamicColors in MainActivity, so on Android 12+ this follows the wallpaper palette;
      on older devices it falls back to the static M3 baseline below.
    -->
    <style name="Theme.SbCompanion" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
        <item name="android:windowLightNavigationBar">?attr/isLightTheme</item>
    </style>

    <style name="OnboardStepRow">
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="OnboardStepNum">
        <item name="android:layout_width">32dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnPrimaryContainer</item>
        <item name="android:background">@drawable/hero_circle</item>
        <item name="android:backgroundTint">?attr/colorPrimaryContainer</item>
    </style>

    <style name="OnboardStepText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Expressive display style for the big title. -->
    <style name="TextAppearance.SbCompanion.Display" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

</resources>
