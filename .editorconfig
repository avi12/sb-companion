root = true

# Formatting rules ported from ../youtube-time-manager eslint.config.js.
# ktlint reads these; mapped @stylistic rule noted above each entry.

[*]
charset = utf-8
end_of_line = lf
# @stylistic/eol-last
insert_final_newline = true
# @stylistic/no-trailing-spaces
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_style = space
# @stylistic/indent: 2
indent_size = 2
# @stylistic/max-len: 120
max_line_length = 120
# @stylistic/comma-dangle: never
ij_kotlin_allow_trailing_comma = false
ij_kotlin_allow_trailing_comma_on_call_site = false
# no wildcard imports; imports sorted (perfectionist/sort-imports)
ktlint_standard_no-wildcard-imports = enabled
ktlint_standard_import-ordering = enabled
# comma-dangle: never -> Kotlin trailing-comma rules stay off
ktlint_standard_trailing-comma-on-call-site = disabled
ktlint_standard_trailing-comma-on-declaration-site = disabled

[*.{json,yml,yaml,gradle}]
indent_style = space
indent_size = 2
